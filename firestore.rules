rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validNewProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'uid', 'displayName', 'email', 'language',
        'selectedGoals', 'createdAt'
      ])
      && d.uid == uid
      && d.displayName is string
      && d.displayName.size() > 0
      && d.displayName.size() <= 80
      && (!('language' in d) ||
          d.language in ['hi', 'en', 'hinglish'])
      && (!('selectedGoals' in d) ||
          d.selectedGoals is list);
    }

    function validLegacyProfileUpdate(uid) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'uid', 'displayName', 'language', 'selectedGoals'
      ])
      && d.uid == uid
      && (!('displayName' in d) ||
          (d.displayName is string &&
           d.displayName.size() > 0 &&
           d.displayName.size() <= 80))
      && (!('language' in d) ||
          d.language in ['hi', 'en', 'hinglish'])
      && (!('selectedGoals' in d) ||
          d.selectedGoals is list);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validNewProfile(uid);
      allow update: if isOwner(uid) && validLegacyProfileUpdate(uid);
      allow delete: if isOwner(uid);

      match /onboarding/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /syllabus_progress/{trackId} {
        allow read, write: if isOwner(uid);
      }

      match /study_plan/{planId} {
        allow read, write: if isOwner(uid);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(uid);
      }

      match /quiz_attempts/{attemptId} {
        allow read, write: if isOwner(uid);
      }

      // AI Teacher chat history is private to this authenticated student.
      match /ai_teacher_messages/{messageId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['role', 'text', 'createdAt'])
          && request.resource.data.role in ['user', 'model']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /syllabus_catalog/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /admin_roles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
