rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function validProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'displayName', 'email', 'language', 'selectedGoals', 'createdAt'])
        && d.uid == uid
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80
        && (!('language' in d) || d.language in ['hi', 'en', 'hinglish'])
        && (!('selectedGoals' in d) || d.selectedGoals is list);
    }

    // Private profile: only the signed-in owner. No role/admin field exists here.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(uid);
      allow delete: if isOwner(uid);

      // Explicit subcollections only (a recursive wildcard would also match the
      // profile document itself and bypass validProfile).
      match /onboarding/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Syllabus progress belongs only to the authenticated account owner.
      match /syllabus_progress/{trackId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Shared public syllabus data (Phase 4): everyone signed-in can read, nobody can write from the app.
    match /syllabus_catalog/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Admin roles are assigned only from the Firebase console / trusted backend.
    match /admin_roles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
