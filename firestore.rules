rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validNewProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'uid', 'displayName', 'email', 'language',
        'selectedGoals', 'createdAt'
      ])
      && d.uid == uid
      && d.displayName is string
      && d.displayName.size() > 0
      && d.displayName.size() <= 80
      && (!('language' in d) ||
          d.language in ['hi', 'en', 'hinglish'])
      && (!('selectedGoals' in d) ||
          d.selectedGoals is list);
    }

    function validLegacyProfileUpdate(uid) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'uid', 'displayName', 'language', 'selectedGoals'
      ])
      && d.uid == uid
      && (!('displayName' in d) ||
          (d.displayName is string &&
           d.displayName.size() > 0 &&
           d.displayName.size() <= 80))
      && (!('language' in d) ||
          d.language in ['hi', 'en', 'hinglish'])
      && (!('selectedGoals' in d) ||
          d.selectedGoals is list);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validNewProfile(uid);
      // Existing accounts may contain older profile fields. Owners can update
      // only these safe profile fields; unknown legacy fields are preserved.
      allow update: if isOwner(uid) && validLegacyProfileUpdate(uid);
      allow delete: if isOwner(uid);

      match /onboarding/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /syllabus_progress/{trackId} {
        allow read, write: if isOwner(uid);
      }

      // Each student's study plan is private to their authenticated account.
      match /study_plan/{planId} {
        allow read, write: if isOwner(uid);
      }

      // Notes are private to the authenticated owner of this user document.
      match /notes/{noteId} {
        allow read, write: if isOwner(uid);
      }

      // Quiz attempts and scores are private to each authenticated student.
      match /quiz_attempts/{attemptId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /syllabus_catalog/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /admin_roles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
